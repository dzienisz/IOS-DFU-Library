{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Callback called in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUState\/uploading","type":"reference"},{"text":" state during firmware upload.","type":"text"}],"identifier":{"url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUProgressDelegate\/dfuProgressDidChange(for:outOf:to:currentSpeedBytesPerSecond:avgSpeedBytesPerSecond:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/nordicdfu\/dfuprogressdelegate\/dfuprogressdidchange(for:outof:to:currentspeedbytespersecond:avgspeedbytespersecond:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUProgressDelegate"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dfuProgressDidChange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"part"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"outOf"},{"kind":"text","text":" "},{"kind":"internalParam","text":"totalParts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"progress"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentSpeedBytesPerSecond"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"avgSpeedBytesPerSecond"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Number of part that is currently being transmitted. Parts","type":"text"},{"text":" ","type":"text"},{"text":"start from 1 and may have value either 1 or 2. Part 2 is","type":"text"},{"text":" ","type":"text"},{"text":"used only when there were Soft Device and\/or Bootloader AND","type":"text"},{"text":" ","type":"text"},{"text":"an Application in the Distribution Packet and the DFU target","type":"text"},{"text":" ","type":"text"},{"text":"does not support sending all files in a single connection.","type":"text"},{"text":" ","type":"text"},{"text":"First the SD and\/or BL will be sent, then the service will","type":"text"},{"text":" ","type":"text"},{"text":"disconnect, reconnect again to the (new) bootloader and send","type":"text"},{"text":" ","type":"text"},{"text":"the Application.","type":"text"}]}],"name":"part"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Total number of parts that are to be send (this is always","type":"text"},{"text":" ","type":"text"},{"text":"equal to 1 or 2).","type":"text"}]}],"name":"totalParts"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The current progress of uploading the current part in","type":"text"},{"text":" ","type":"text"},{"text":"percentage (values 0-100).","type":"text"},{"text":" ","type":"text"},{"text":"Each value will be called at most once - in case of a large","type":"text"},{"text":" ","type":"text"},{"text":"file a value e.g. 3% will be called only once, despite that","type":"text"},{"text":" ","type":"text"},{"text":"it will take more than one packet to reach 4%. In case of","type":"text"},{"text":" ","type":"text"},{"text":"a small firmware file some values may be omitted.","type":"text"},{"text":" ","type":"text"},{"text":"For example, if firmware file would be only 20 bytes you","type":"text"},{"text":" ","type":"text"},{"text":"would get a callback 0% (called always) and then 100% when done.","type":"text"}]}],"name":"progress"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The current speed in bytes per second.","type":"text"}]}],"name":"currentSpeedBytesPerSecond"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The average speed in bytes per second.","type":"text"}]}],"name":"avgSpeedBytesPerSecond"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Gives detailed information about the progress and speed of transmission."},{"type":"text","text":" "},{"type":"text","text":"This method is always called at least two times (for 0% and 100%) if upload has"},{"type":"text","text":" "},{"type":"text","text":"started and did not fail and is not called multiple times for the same number of"},{"type":"text","text":" "},{"type":"text","text":"percentage."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method is called in the thread set as "},{"type":"codeVoice","code":"progressQueue"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/init(queue:delegateQueue:progressQueue:loggerQueue:centralManagerOptions:)"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"required":true,"externalID":"c:@M@NordicDFU@objc(pl)DFUProgressDelegate(im)dfuProgressDidChangeFor:outOf:to:currentSpeedBytesPerSecond:avgSpeedBytesPerSecond:","symbolKind":"method","modules":[{"name":"NordicDFU"}],"role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dfuProgressDidChange"},{"text":"(","ki
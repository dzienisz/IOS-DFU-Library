{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator"]]},"identifier":{"url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/enableUnsafeExperimentalButtonlessServiceInSecureDfu","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","modules":[{"name":"NordicDFU"}],"roleHeading":"Instance Property","role":"symbol","title":"enableUnsafeExperimentalButtonlessServiceInSecureDfu","externalID":"c:@M@NordicDFU@objc(cs)DFUServiceInitiator(py)enableUnsafeExperimentalButtonlessServiceInSecureDfu","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"enableUnsafeExperimentalButtonlessServiceInSecureDfu"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Should the library discover Experimental Buttonless Service from nRF5 SDK version 12.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"enableUnsafeExperimentalButtonlessServiceInSecureDfu"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set this flag to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" to enable experimental buttonless feature in Secure DFU."},{"type":"text","text":" "},{"type":"text","text":"When the experimental Buttonless DFU Service is found on a device, the service"},{"type":"text","text":" "},{"type":"text","text":"will use it to switch the device to the bootloader mode, connect to it in that"},{"type":"text","text":" "},{"type":"text","text":"mode and proceed with DFU."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the SDK 12.x the Buttonless DFU feature for Secure DFU was experimental."},{"type":"text","text":" "},{"type":"text","text":"It is NOT recommended to use it: it was not properly tested, had implementation bugs"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"identifier":"https:\/\/devzone.nordicsemi.com\/question\/100609\/sdk-12-bootloader-erased-after-programming\/","isActive":true,"type":"reference"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and does not required encryption and therefore may lead to DOS attack (anyone can"},{"type":"text","text":" "},{"type":"text","text":"use it to switch the device to bootloader mode). However, as there is no other way"},{"type":"text","text":" "},{"type":"text","text":"to trigger bootloader mode on devices without a button, this DFU Library supports"},{"type":"text","text":" "},{"type":"text","text":"this service, but the feature must be explicitly enabled here. Be aware, that setting"},{"type":"text","text":" "},{"type":"text","text":"this flag to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" will no protect your devices from this kind of attacks, as"},{"type":"text","text":" "},{"type":"text","text":"an attacker may use another app for that purpose."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Spec:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Buttonless DFU Service UUID: "},{"code":"8E400001-F315-4F60-9FB8-838830DAEA50","type":"codeVoice"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Buttonless DFU characteristic UUID: "},{"code":"8E400001-F315-4F60-9FB8-838830DAEA50","type":"codeVoice"},{"type":"text","text":" (the same)"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter Bootloader Op Code: "},{"code":"0x01","type":"codeVoice"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Correct return value: "},{"code":"0x20-01-01","type":"codeVoice"},{"type":"text","text":" , where:"},{"type":"text","text":" "},{"code":"0x20","type":"codeVoice"},{"type":"text","text":" - Response Op Code"},{"type":"text","text":" "},{"code":"0x01","type":"codeVoice"},{"type":"text","text":" - Request Code"},{"type":"text","text":" "},{"code":"0x01","type":"codeVoice"},{"type":"text","text":" - Success"},{"type":"text","text":" "},{"type":"text","text":"The device should disconnect and restart in DFU mode after sending the notification."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SDK 13 this issue was be fixed by a proper implementation (bonding supported,"},{"type":"text","text":" "},{"type":"text","text":"passing bond information to the bootloader, encryption, well tested)."},{"type":"text","text":" "},{"type":"text","text":"It is recommended to migrate to SDK 13 or newer"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/nordicdfu\/dfuserviceinitiator\/enableunsafeexperimentalbuttonlessserviceinsecuredfu"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator/enableUnsafeExperimentalButtonlessServiceInSecureDfu":{"kind":"symbol","title":"enableUnsafeExperimentalButtonlessServiceInSecureDfu","type":"topic","abstract":[{"type":"text","text":"Should the library discover Experimental Buttonless Service from nRF5 SDK version 12."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator\/enableunsafeexperimentalbuttonlessserviceinsecuredfu","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableUnsafeExperimentalButtonlessServiceInSecureDfu","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/enableUnsafeExperimentalButtonlessServiceInSecureDfu"},"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator","title":"DFUServiceInitiator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUServiceInitiator"}],"abstract":[{"type":"text","text":"The initiator object should be used to initiate updating firmware"},{"type":"text","text":" "},{"type":"text","text":"on a remote Bluetooth LE target compatible with the Nordic Semiconductor’s Legacy or"},{"type":"text","text":" "},{"type":"text","text":"Secure DFU (Device Firmware Update) protocol from nRF5 SDK."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator","navigatorTitle":[{"kind":"identifier","text":"DFUServiceInitiator"}]},"https://devzone.nordicsemi.com/question/100609/sdk-12-bootloader-erased-after-programming/":{"url":"https:\/\/devzone.nordicsemi.com\/question\/100609\/sdk-12-bootloader-erased-after-programming\/","identifier":"https:\/\/devzone.nordicsemi.com\/question\/100609\/sdk-12-bootloader-erased-after-programming\/","title":"this one","type":"link","titleInlineContent":[{"text":"this one","type":"text"}]},"doc://NordicDFU/documentation/NordicDFU":{"url":"\/documentation\/nordicdfu","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU","abstract":[{"type":"text","text":"A Swift library for updating firmware of nRF51 and nRF52 devices over Bluetooth LE."}],"title":"NordicDFU"}}}
{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator"]]},"identifier":{"url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/alternativeAdvertisingName","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","modules":[{"name":"NordicDFU"}],"roleHeading":"Instance Property","role":"symbol","title":"alternativeAdvertisingName","externalID":"c:@M@NordicDFU@objc(cs)DFUServiceInitiator(py)alternativeAdvertisingName","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"alternativeAdvertisingName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The name the bootloader should use in advertisement.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"alternativeAdvertisingName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/alternativeAdvertisingNameEnabled","isActive":true,"type":"reference"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" then this specifies the"},{"type":"text","text":" "},{"type":"text","text":"alternative name to use. If "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" (default) then a random name is generated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The maximum length of the alternative advertising name is 18 UTF-8 bytes."},{"type":"text","text":" "},{"type":"text","text":"This is required to keep the Set Name request (1-byte op code, 1-byte"},{"type":"text","text":" "},{"type":"text","text":"length and the name itself) within the 20-byte payload of the default"},{"type":"text","text":" "},{"type":"text","text":"ATT MTU. CoreBluetooth always reports the maximum write-with-response"},{"type":"text","text":" "},{"type":"text","text":"length as 512 once Long Write is supported, so the limit cannot be"},{"type":"text","text":" "},{"type":"text","text":"derived dynamically and a longer name would fall back to ATT Prepare"},{"type":"text","text":" "},{"type":"text","text":"Write, which Nordic’s buttonless DFU service does not handle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The library validates the name before writing it to the device and fails"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUError\/invalidAdvertisementName","isActive":true,"type":"reference"},{"type":"text","text":" if it is too long."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/nordicdfu\/dfuserviceinitiator\/alternativeadvertisingname"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator","title":"DFUServiceInitiator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUServiceInitiator"}],"abstract":[{"type":"text","text":"The initiator object should be used to initiate updating firmware"},{"type":"text","text":" "},{"type":"text","text":"on a remote Bluetooth LE target compatible with the Nordic Semiconductor’s Legacy or"},{"type":"text","text":" "},{"type":"text","text":"Secure DFU (Device Firmware Update) protocol from nRF5 SDK."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator","navigatorTitle":[{"kind":"identifier","text":"DFUServiceInitiator"}]},"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator/alternativeAdvertisingNameEnabled":{"kind":"symbol","title":"alternativeAdvertisingNameEnabled","type":"topic","abstract":[{"type":"text","text":"Should the bootloader use random name to make it distinguishable from other devices."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator\/alternativeadvertisingnameenabled","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alternativeAdvertisingNameEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/alternativeAdvertisingNameEnabled"},"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator/alternativeAdvertisingName":{"kind":"symbol","title":"alternativeAdvertisingName","type":"topic","abstract":[{"type":"text","text":"The name the bootloader should use in advertisement."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator\/alternativeadvertisingname","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alternativeAdvertisingName","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/alternativeAdvertisingName"},"doc://NordicDFU/documentation/NordicDFU":{"url":"\/documentation\/nordicdfu","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU","abstract":[{"type":"text","text":"A Swift library for updating firmware of nRF51 and nRF52 devices over Bluetooth LE."}],"title":"NordicDFU"},"doc://NordicDFU/documentation/NordicDFU/DFUError/invalidAdvertisementName":{"kind":"symbol","title":"DFUError.invalidAdvertisementName","type":"topic","abstract":[{"text":"The requested advertising name is too long for the current ATT MTU.","type":"text"}],"url":"\/documentation\/nordicdfu\/dfuerror\/invalidadvertisementname","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidAdvertisementName"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUError\/invalidAdvertisementName"}}}
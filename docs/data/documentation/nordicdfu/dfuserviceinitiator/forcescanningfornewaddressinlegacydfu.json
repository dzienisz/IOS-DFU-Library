{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Should the Legacy DFU service scan for the device after switching to bootloader mode.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/forceScanningForNewAddressInLegacyDfu"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/nordicdfu\/dfuserviceinitiator\/forcescanningfornewaddressinlegacydfu"]}],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"forceScanningForNewAddressInLegacyDfu"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"By default, the Legacy DFU bootloader, starting from SDK 7.1, when enabled using","type":"text"},{"text":" ","type":"text"},{"text":"buttonless service, advertises with the same Bluetooth address as the application","type":"text"},{"text":" ","type":"text"},{"text":"using direct advertisement. This complies with the Bluetooth specification.","type":"text"},{"text":" ","type":"text"},{"text":"However, on iOS 13.x, iPhones and iPads use random addresses on each","type":"text"},{"text":" ","type":"text"},{"text":"connection and do not expect direct advertising unless bonded. This causes those","type":"text"},{"text":" ","type":"text"},{"text":"packets being missed and not reported to the library, making reconnection to the","type":"text"},{"text":" ","type":"text"},{"text":"bootloader and proceeding with DFU impossible.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A solution requires modifying either the bootloader not to use the direct advertising,","type":"text"},{"text":" ","type":"text"},{"text":"or the application not to share the peer data with bootloader, in which case it will","type":"text"},{"text":" ","type":"text"},{"text":"advertise indirectly using address +1, like it does when the switch to bootloader mode","type":"text"},{"text":" ","type":"text"},{"text":"is initiated with a button. After such modification, setting this flag to true will make the","type":"text"},{"text":" ","type":"text"},{"text":"library scan for the bootloader using ","type":"text"},{"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelector","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Setting this flag to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" without modifying the bootloader behavior will break the DFU,","type":"text"},{"text":" ","type":"text"},{"text":"as the direct advertising packets are empty and will not pass the default","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelector","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"4.8.0"}],"type":"paragraph"}],"type":"aside"}]}],"metadata":{"externalID":"c:@M@NordicDFU@objc(cs)DFUServiceInitiator(py)forceScanningForNewAddressInLegacyDfu","symbolKind":"property","modules":[{"name":"NordicDFU"}],"role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"forceScanningForNewAddressInLegacyDfu"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"forceScanningForNewAddressInLegacyDfu"},"references":{"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator/forceScanningForNewAddressInLegacyDfu":{"kind":"symbol","title":"forceScanningForNewAddressInLegacyDfu","type":"topic","abstract":[{"type":"text","text":"Should the Legacy DFU service scan for the device after switching to bootloader mode."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator\/forcescanningfornewaddressinlegacydfu","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceScanningForNewAddressInLegacyDfu","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/forceScanningForNewAddressInLegacyDfu"},"doc://NordicDFU/documentation/NordicDFU":{"url":"\/documentation\/nordicdfu","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU","abstract":[{"type":"text","text":"A Swift library for updating firmware of nRF51 and nRF52 devices over Bluetooth LE."}],"title":"NordicDFU"},"doc://NordicDFU/documentation/NordicDFU/DFUPeripheralSelectorDelegate":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DFUPeripheralSelectorDelegate"}],"title":"DFUPeripheralSelectorDelegate","type":"topic","abstract":[{"text":"The DFU peripheral selector delegate is used to select the device advertising in","type":"text"},{"text":" ","type":"text"},{"text":"DFU bootloader mode after switching from application mode.","type":"text"}],"url":"\/documentation\/nordicdfu\/dfuperipheralselectordelegate","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUPeripheralSelectorDelegate"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelectorDelegate"},"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator","title":"DFUServiceInitiator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUServiceInitiator"}],"abstract":[{"type":"text","text":"The initiator object should be used to initiate updating firmware"},{"type":"text","text":" "},{"type":"text","text":"on a remote Bluetooth LE target compatible with the Nordic Semiconductor’s Legacy or"},{"type":"text","text":" "},{"type":"text","text":"Secure DFU (Device Firmware Update) protocol from nRF5 SDK."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator","navigatorTitle":[{"kind":"identifier","text":"DFUServiceInitiator"}]},"doc://NordicDFU/documentation/NordicDFU/DFUPeripheralSelector":{"kind":"symbol","navigatorTitle":[{"text":"DFUPeripheralSelector","kind":"identifier"}],"title":"DFUPeripheralSelector","type":"topic","abstract":[{"type":"text","text":"The default implementation of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelectorDelegate"},{"type":"text","text":"."}],"url":"\/documentation\/nordicdfu\/dfuperipheralselector","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DFUPeripheralSelector","kind":"identifier"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelector"}}}
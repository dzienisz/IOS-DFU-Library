{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"NordicDFU"}],"role":"symbol","title":"alternativeAdvertisingNameEnabled","externalID":"c:@M@NordicDFU@objc(cs)DFUServiceInitiator(py)alternativeAdvertisingNameEnabled","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"alternativeAdvertisingNameEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/alternativeAdvertisingNameEnabled"},"abstract":[{"type":"text","text":"Should the bootloader use random name to make it distinguishable from other devices."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alternativeAdvertisingNameEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"In SDK 14.0.0 a new feature was added to the Buttonless DFU for non-bonded","type":"text"},{"text":" ","type":"text"},{"text":"devices which allows to send a unique name to the device before it is switched","type":"text"},{"text":" ","type":"text"},{"text":"to bootloader mode. After jump, the bootloader will advertise with this name","type":"text"},{"type":"text","text":" "},{"text":"as the Complete Local Name making it easy to select proper device. In this case","type":"text"},{"type":"text","text":" "},{"text":"you don’t have to override the default peripheral selector.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Read more at "},{"type":"reference","isActive":true,"identifier":"http:\/\/infocenter.nordicsemi.com\/topic\/com.nordic.infocenter.sdk5.v14.0.0\/service_dfu.html"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Setting this flag to "},{"type":"codeVoice","code":"false"},{"text":" you will disable this feature. iOS DFU Library will","type":"text"},{"text":" ","type":"text"},{"text":"not send the ","type":"text"},{"code":"0x02-[len]-[new name]","type":"codeVoice"},{"text":" command prior jumping and will","type":"text"},{"text":" ","type":"text"},{"text":"rely on the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/peripheralSelector","type":"reference"},{"text":" just like it used to in previous SDK.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This flag is ignored in Legacy DFU.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"It is recommended to keep this flag set to true unless necessary."}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"For more information read ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/nordicsemi\/IOS-nRF-Connect\/issues\/16","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/nordicdfu\/dfuserviceinitiator\/alternativeadvertisingnameenabled"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://NordicDFU/documentation/NordicDFU":{"url":"\/documentation\/nordicdfu","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU","abstract":[{"type":"text","text":"A Swift library for updating firmware of nRF51 and nRF52 devices over Bluetooth LE."
{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator"]]},"identifier":{"url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/packetReceiptNotificationParameter","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","modules":[{"name":"NordicDFU"}],"roleHeading":"Instance Property","role":"symbol","title":"packetReceiptNotificationParameter","externalID":"c:@M@NordicDFU@objc(cs)DFUServiceInitiator(py)packetReceiptNotificationParameter","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"packetReceiptNotificationParameter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The number of packets of firmware data to be received by the DFU target before","type":"text"},{"text":" ","type":"text"},{"text":"sending a new Packet Receipt Notification.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"packetReceiptNotificationParameter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V","text":"UInt16"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this value is 0, the packet receipt notification will be disabled by the DFU target."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Default value is 12."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"PRNs are no longer required on iOS 11 and MacOS 10.13 or newer, but","type":"text"},{"text":" ","type":"text"},{"text":"make sure your device is able to be updated without. Old SDKs, before SDK 7","type":"text"},{"text":" ","type":"text"},{"text":"had very slow memory management and could not handle packets that fast.","type":"text"},{"text":" ","type":"text"},{"text":"If your device is based on such SDK it is recommended to leave the default value.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Disabling PRNs increases upload speed but may cause failures on devices with slow flash"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On older versions, higher values of PRN (~20+), or disabling it, may speed up"},{"type":"text","text":" "},{"type":"text","text":"the upload process, but also cause a buffer overflow and hang the Bluetooth adapter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum verified values were 29 for iPhone 6 Plus or 22 for iPhone 7, both iOS 10.1."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/nordicdfu\/dfuserviceinitiator\/packetreceiptnotificationparameter"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator","title":"DFUServiceInitiator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUServiceInitiator"}],"abstract":[{"type":"text","text":"The initiator object should be used to initiate updating firmware"},{"type":"text","text":" "},{"type":"text","text":"on a remote Bluetooth LE target compatible with the Nordic Semiconductor’s Legacy or"},{"type":"text","text":" "},{"type":"text","text":"Secure DFU (Device Firmware Update) protocol from nRF5 SDK."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator","navigatorTitle":[{"kind":"identifier","text":"DFUServiceInitiator"}]},"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator/packetReceiptNotificationParameter":{"kind":"symbol","title":"packetReceiptNotificationParameter","type":"topic","abstract":[{"type":"text","text":"The number of packets of firmware data to be received by the DFU target before"},{"type":"text","text":" "},{"type":"text","text":"sending a new Packet Receipt Notification."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator\/packetreceiptnotificationparameter","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"packetReceiptNotificationParameter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6UInt16V","text":"UInt16","kind":"typeIdentifier"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/packetReceiptNotificationParameter"},"doc://NordicDFU/documentation/NordicDFU":{"url":"\/documentation\/nordicdfu","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU","abstract":[{"type":"text","text":"A Swift library for updating firmware of nRF51 and nRF52 devices over Bluetooth LE."}],"title":"NordicDFU"}}}
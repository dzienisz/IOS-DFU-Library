{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator"]]},"metadata":{"symbolKind":"property","modules":[{"name":"NordicDFU"}],"roleHeading":"Instance Property","role":"symbol","title":"dataObjectPreparationDelay","externalID":"c:@M@NordicDFU@objc(cs)DFUServiceInitiator(py)dataObjectPreparationDelay","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dataObjectPreparationDelay","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"}]},"identifier":{"url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/dataObjectPreparationDelay","interfaceLanguage":"swift"},"abstract":[{"text":"Duration of a delay, that the service will wait before sending each data object in","type":"text"},{"text":" ","type":"text"},{"text":"Secure DFU.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dataObjectPreparationDelay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The delay will be done after a data object is created, and before","type":"text"},{"text":" ","type":"text"},{"text":"any data byte is sent. The default value is 0, which disables this feature for the","type":"text"},{"text":" ","type":"text"},{"text":"second and following data objects, but the first one will be delayed by 0.4 sec.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It has been found, that a delay of at least 0.3 sec reduces the risk of packet lose","type":"text"},{"text":" ","type":"text"},{"text":"(the bootloader needs some time to prepare flash memory) on DFU bootloader from","type":"text"},{"text":" ","type":"text"},{"text":"SDK 15, 16 and 17. The delay does not have to be longer than 0.4 sec, as according to","type":"text"},{"text":" ","type":"text"},{"text":"performed tests, such delay is sufficient.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The longer the delay, the more time DFU will take to complete (delay will be repeated for","type":"text"},{"text":" ","type":"text"},{"text":"each data object (4096 bytes)). However, with too small delay a packet lose may occur,","type":"text"},{"text":" ","type":"text"},{"text":"causing the service to enable PRN and set them to 1 making DFU process very, very slow","type":"text"},{"text":" ","type":"text"},{"text":"(but reliable).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The recommended delay is from 0.3 to 0.4 second if your DFU bootloader is from","type":"text"},{"text":" ","type":"text"},{"text":"SDK 15, 16 or 17. Older bootloaders do not need this delay.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This variable is ignored in Legacy DFU.","type":"text"}],"type":"paragraph"},{"name":"Since","content":[{"inlineContent":[{"text":"4.8.0","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/nordicdfu\/dfuserviceinitiator\/dataobjectpreparationdelay"]}],"references":{"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator","title":"DFUServiceInitiator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUServiceInitiator"}],"abstract":[{"type":"text","text":"The initiator object should be used to initiate updating firmware"},{"type":"text","text":" "},{"type":"text","text":"on a remote Bluetooth LE target compatible with the Nordic Semiconductor’s Legacy or"},{"type":"text","text":" "},{"type":"text","text":"Secure DFU (Device Firmware Update) protocol from nRF5 SDK."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator","navigatorTitle":[{"kind":"identifier","text":"DFUServiceInitiator"}]},"doc://NordicDFU/documentation/NordicDFU/DFUServiceInitiator/dataObjectPreparationDelay":{"kind":"symbol","title":"dataObjectPreparationDelay","type":"topic","abstract":[{"type":"text","text":"Duration of a delay, that the service will wait before sending each data object in"},{"type":"text","text":" "},{"type":"text","text":"Secure DFU."}],"url":"\/documentation\/nordicdfu\/dfuserviceinitiator\/dataobjectpreparationdelay","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dataObjectPreparationDelay","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"}],"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator\/dataObjectPreparationDelay"},"doc://NordicDFU/documentation/NordicDFU":{"url":"\/documentation\/nordicdfu","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU","abstract":[{"type":"text","text":"A Swift library for updating firmware of nRF51 and nRF52 devices over Bluetooth LE."}],"title":"NordicDFU"}}}
{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelectorDelegate"},"kind":"symbol","topicSections":[{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelectorDelegate\/filterBy(hint:)","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelectorDelegate\/select(_:advertisementData:RSSI:hint:)"],"anchor":"Instance-Methods"}],"hierarchy":{"paths":[["doc:\/\/NordicDFU\/documentation\/NordicDFU"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DFUPeripheralSelectorDelegate"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When a peripheral is switching to the bootloader mode that will change its MAC"},{"type":"text","text":" "},{"type":"text","text":"address the library needs to select the correct device to continue the DFU"},{"text":" ","type":"text"},{"type":"text","text":"process. As MAC addresses are not exposed using iOS API, the selector"},{"type":"text","text":" "},{"text":"provides a mechanism choosing the correct target.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The default implementation is provided by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelector","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This library supports sending both BIN files from a ZIP Distribution","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Packet automatically. However, when sending the SoftDevice update, the"},{"type":"text","text":" "},{"type":"text","text":"DFU Bootloader may remove the current application in order to make space"},{"type":"text","text":" "},{"type":"text","text":"for the new SoftDevice firmware (Legacy DFU, or Secure DFU with single"},{"type":"text","text":" "},{"type":"text","text":"bank enabled when new SD+BL are larger then space available) or may"},{"type":"text","text":" "},{"type":"text","text":"advertise in Bootloader mode for number of seconds (Secure DFU). When the"},{"type":"text","text":" "},{"type":"text","text":"new SoftDevice is flashed the bootloader restarts the device and starts"},{"type":"text","text":" "},{"type":"text","text":"advertising in DFU Bootloader mode."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since SDK 8.0.0, to solve caching problem on a host that is not bonded"},{"type":"text","text":" "},{"type":"text","text":"(in case there is no Service Changed characteristic), the bootloader"},{"type":"text","text":" "},{"type":"text","text":"starts to advertise with an address incremented by 1. The DFU Library has"},{"type":"text","text":" "},{"type":"text","text":"to scan for a peripheral with this new address. However, as iOS does not"},{"type":"text","text":" "},{"type":"text","text":"expose the device address in the public CoreBluetooth API, address matching,"},{"type":"text","text":" "},{"type":"text","text":"used on Android, can not be used. Instead, this selector is used. The DFU"},{"type":"text","text":" "},{"type":"text","text":"Service will start scanning for peripherals with a UUID filter, where the"},{"type":"text","text":" "},{"type":"text","text":"list of required UUID is returned by the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelectorDelegate\/filterBy(hint:)"},{"type":"text","text":" method. If your"},{"type":"text","text":" "},{"text":"device in the Bootloader mode does not advertise with any service UUIDs,","type":"text"},{"text":" ","type":"text"},{"text":"or this is not enough, you may select a target device by their advertising","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"packet or RSSI using this delegate."}]},{"type":"paragraph","inlineContent":[{"text":"In SDK 14.0.0 a new feature was added to the Buttonless DFU for non-bonded","type":"text"},{"type":"text","text":" "},{"text":"devices which allows to send a unique name to the device before it is","type":"text"},{"text":" ","type":"text"},{"text":"switched to bootloader mode. After jump, the bootloader will advertise","type":"text"},{"text":" ","type":"text"},{"text":"with this name as the Complete Local Name making it easy to select proper","type":"text"},{"text":" ","type":"text"},{"text":"device. In this case you don’t have to override the default peripheral","type":"text"},{"text":" ","type":"text"},{"text":"selector.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Read more about the new feature on ","type":"text"},{"isActive":true,"identifier":"https:\/\/infocenter.nordicsemi.com\/topic\/sdk_nrf5_v17.1.0\/ble_sdk_app_buttonless_dfu.html?cp=9_1_4_4_1","type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUPeripheralSelector"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/nordicdfu\/dfuperipheralselectordelegate"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The DFU peripheral selector delegate is used to select the device advertising in","type":"text"},{"text":" ","type":"text"},{"text":"DFU bootloader mode after switching from application mode.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Initialization","anchor":"Initialization","identifiers":["doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceInitiator","doc:\/\/NordicDFU\/documentation\/NordicDFU\/DFUServiceDelegate","doc:\/\/NordicDFU\/documenta